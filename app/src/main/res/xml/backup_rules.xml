<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Exclude SQLCipher encrypted Room databases & WAL/SHM files because the Android Keystore master key is hardware-bound -->
    <exclude domain="database" path="drama_db" />
    <exclude domain="database" path="drama_db-wal" />
    <exclude domain="database" path="drama_db-shm" />
    <exclude domain="database" path="drama_db-journal" />

    <!-- Exclude Tink Keystore-wrapped preferences & DataStore -->
    <exclude domain="sharedpref" path="moglog_secure_store.xml" />
    <exclude domain="sharedpref" path="moglog_tink_keyset_prefs.xml" />
    <exclude domain="sharedpref" path="moglog_prefs.xml" />
    <exclude domain="file" path="datastore/moglog_settings.preferences_pb" />
</full-backup-content>